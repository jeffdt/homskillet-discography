{
  "name": "chip-player-js",
  "version": "0.1.0",
  "private": true,
  "repository": "https://github.com/mmontag/chip-player-js",
  "description": "Web-based music player for a variety of video game and chiptune music formats.",
  "dependencies": {
    "@babel/plugin-syntax-bigint": "^7.8.3",
    "@babel/plugin-transform-optional-chaining": "^7.22.5",
    "@typescript-eslint/eslint-plugin": "5.59.9",
    "@typescript-eslint/parser": "5.59.9",
    "auto-bind": "^5.0.1",
    "autoprefixer": "7.1.6",
    "chalk": "^2.4.1",
    "chroma-js": "^1.4.0",
    "directory-tree": "2.2.1",
    "dotenv": "4.0.0",
    "dotenv-expand": "4.2.0",
    "eslint": "^8.42.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "events": "^3.3.0",
    "fili": "^2.0.3",
    "fs-extra": "3.0.1",
    "immutability-helper": "^2.7.1",
    "ismobilejs": "^0.4.1",
    "lodash": "^4.17.21",
    "node-unrar-js": "^0.8.1",
    "object-assign": "4.1.1",
    "path-parse": "^1.0.7",
    "postcss-flexbugs-fixes": "3.2.0",
    "promise": "8.0.1",
    "raf": "3.4.0",
    "react": "^16.8.0",
    "react-dom": "^16.8.0",
    "react-router-dom": "^5.2.0",
    "react-virtual-list": "git+https://github.com/glebcha/react-virtual-list.git#544bc7",
    "react-virtualized": "^9.22.5",
    "react-window": "^1.8.10",
    "resolve": "1.6.0",
    "roman-numerals": "^0.3.2",
    "typescript": "^3.5.2",
    "whatwg-fetch": "2.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^2.1.9",
    "cheerio": "^1.0.0-rc.2",
    "child_process": "^1.0.2",
    "gh-pages": "^6.3.0",
    "glob": "^7.1.2",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^16.2.7",
    "node-stream-zip": "^1.7.0",
    "patch-package": "^5.1.1",
    "postinstall-prepare": "^1.0.1",
    "prettier": "^3.7.4",
    "request": "^2.88.0",
    "request-promise": "^4.2.2",
    "sanitize-filename": "^1.6.1",
    "sharp": "^0.34.5",
    "tmp": "^0.0.33",
    "trie-search": "1.2.8",
    "unzipper": "^0.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "homepage": "https://jeffdt.com/",
  "scripts": {
    "start": "bun run vite",
    "build": "bun run build-catalog && bun run build-chip-core && bun run vite build",
    "build-lite": "bun run vite build",
    "preview": "bun run vite preview",
    "test": "bun run vitest",
    "test:ui": "bun run vitest --ui",
    "test:run": "bun run vitest run",
    "coverage": "bun run vitest run --coverage",
    "build-chip-core": "source ../emsdk/emsdk_env.sh; bun run scripts/build-chip-core.js",
    "build-chip-core:docker": "docker compose run --rm chip-core",
    "build-catalog": "bun run scripts/build-catalog.js",
    "predeploy": "bun run build",
    "deploy": "bun run predeploy && bun run gh-pages -d build --nojekyll",
    "deploy-lite": "bun run build-lite && bun run gh-pages -d build --nojekyll",
    "prepare": "husky",
    "server": "DEV=1 bun run server/index.js",
    "stop": "bash scripts/kill-servers.sh"
  },
  "eslintConfig": {
    "extends": "react-app",
    "env": {
      "es2020": true
    },
    "rules": {
      "jsx-a11y/href-no-hash": "off",
      "jsx-a11y/anchor-is-valid": "off",
      "no-fallthrough": "off",
      "import/no-anonymous-default-export": "off",
      "react/jsx-no-target-blank": "off"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix",
      "vitest related --run"
    ],
    "*.{json,css,md}": "prettier --write"
  }
}
